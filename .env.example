# LLM: any OpenAI-compatible endpoint. Default is Qwen on Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Preview-tier on Groq. Fallback: openai/gpt-oss-120b
LLM_MODEL=qwen/qwen3.8-27b
# Cheap model for news-to-tripwire matching in replay
LLM_MODEL_FAST=openai/gpt-oss-20b
# Alternative: Alibaba DashScope
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Bitget MCP (public, no key)
BITGET_MCP_URL=https://agent.bitget.com/mcp
